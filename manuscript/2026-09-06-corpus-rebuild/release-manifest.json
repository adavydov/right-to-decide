      "criteria": [
        {
          "id": "qualityOfThought",
          "score": 4,
          "reason": "Книга последовательно различает результат, освоение, внешнее продолжение и доступ постороннего; Д удерживает условия этих переходов, не добавляя автоматического успеха."
        },
        {
          "id": "argumentDramaturgy",
          "score": 4,
          "reason": "Шесть частей движутся от исторической цены перехода через понятие, опыт, капитал и власть к праву преемника изменить замысел. Справочная форма Д дополняет эту дугу, а эпилог сохраняет изменившийся взгляд и действие."
        },
        {
          "id": "strongContradiction",
          "score": 4,
          "reason": "Полная помощь ИИ, достаточная свободная команда, компетентный собственник и ценная машинная программа сохраняют основания. Ни книга, ни Д не гарантируют победу или вечное финансирование школы."
        },
        {
          "id": "grounding",
          "score": 3,
          "reason": "Примечания и источниковый раздел Д имеют точные пределы; даты действительного чтения не обновлены редакцией. Аннотация, лабораторный результат и исторический случай не выданы за аудит всей модели. Нового первичного чтения источников этим заключением не заявляется."
        },
        {
          "id": "scenarioHonesty",
          "score": 3,
          "reason": "W20 и W18 вводятся отдельно; земные бюджеты не финансируют космос. В Д297 восстановлена фактическая передача роли конкретной пробы, а «нужный» продукт главы 7 согласован с возможным отрицательным исследовательским результатом главы 16."
        },
        {
          "id": "futureMechanism",
          "score": 4,
          "reason": "Права, спрос, коалиции, полный предел LAB и ежегодные варианты NODE предъявлены вместе с резервами, сроком средств, прекращением и ценой внешнего входа. Одна полезность не оплачивает продолжение."
        },
        {
          "id": "realAuthorship",
          "score": 4,
          "reason": "Участник влияет на вопрос, проверку, средства и допустимый следующий шаг; сильная помощь и сохранение хорошего решения совместимы с этим. В конкретной пробе другой участник действительно принимает ведущую роль и существенное решение."
        },
        {
          "id": "threeResults",
          "score": 4,
          "reason": "Книга и исправленное Д раздельно проверяют изделие, изменение способности и выполненное продолжение с новым получателем. Смена инструмента, прав, состава, лица или выдача файлов сами по себе не доказательство человеческого роста."
        },
        {
          "id": "multipleLayers",
          "score": 4,
          "reason": "История изменяет понимание помощи и передачи; экономика — доступ и продолжение; космос — роль человека как покупателя; Омега — ценность другого источника вопросов. Д связывает условия этих слоёв, не превращая философию в ресурс."
        },
        {
          "id": "livingLanguage",
          "score": 3,
          "reason": "В 1 восстановлен человеческий субъект, в 7 снят соседний повтор. Разные формы и дыхание книги сохранены; плотность паспорта обслуживает поиск условий и не требует старых версий."
        },
        {
          "id": "chapterValue",
          "score": 4,
          "reason": "Главы дают разные последовательные приобретения; Д имеет отдельную справочную ценность полного текущего набора условий. Его нельзя заменить прежним паспортом, а главы — переставить без потери причинности."
        },
        {
          "id": "actionability",
          "score": 3,
          "reason": "Глава 16 и Д предъявляют ограниченный опыт, деньги, время, помощь, выход, конкретную передачу и допустимый неуспех; эпилог возвращает начало в доступное дело. Реальные стороны, запуск и эффект не объявлены установленными."
        }
      ]
    }
  },
