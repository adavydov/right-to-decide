{
  "name": "right-to-decide",
  "version": "1.0.0",
  "private": true,
  "description": "Право на решение — как остаться авторами будущего рядом с более сильным интеллектом",
  "author": "Alexey M. Davydov",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/adavydov/right-to-decide.git"
  },
  "homepage": "https://adavydov.github.io/right-to-decide/",
  "keywords": [
    "engineering-education",
    "artificial-intelligence",
    "cognitive-admission",
    "scientific-monograph",
    "engineering-judgment"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/normalize-static-segments.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/validate-content.mjs",
    "check:export": "node scripts/validate-export.mjs",
    "check": "npm run check:source && npm run lint && npm run typecheck && npm run check:content && npm run build && npm run check:export",
    "check:source": "python scripts/test-publish-manuscript.py && python scripts/test-chapter-docx.py && python scripts/publish-manuscript.py --check"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
